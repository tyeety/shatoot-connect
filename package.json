{
  "name": "shatoot-connect",
  "version": "0.30.0",
  "description": "Windows remote desktop, LAN discovery, peer-to-peer chat, groups and file transfer",
  "main": "desktop/main.cjs",
  "private": true,
  "author": "ShatootSoft",
  "repository": {
    "type": "git",
    "url": "https://github.com/tyeety/shatoot-connect.git"
  },
  "homepage": "https://github.com/tyeety/shatoot-connect#readme",
  "bugs": {
    "url": "https://github.com/tyeety/shatoot-connect/issues"
  },
  "scripts": {
    "start": "electron .",
    "server": "node server/standalone.cjs server/server.config.example.json",
    "dist:server": "npm run build:server-manager && node build/package-server.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "electron . --smoke-test",
    "test:chat-ui": "electron . --smoke-test --chat-notification-smoke",
    "test:crash-recorder": "electron . --smoke-test --crash-recorder-smoke",
    "check:release": "node build/release-notes.cjs",
    "build:native": "dotnet publish native/ShatootConnect.Input.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -o native/publish",
    "dist": "npm run build:native && electron-builder --win nsis portable --x64",
    "test:updater": "powershell -NoProfile -ExecutionPolicy Bypass -File build/test-updater.ps1",
    "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File build/test-installer.ps1",
    "test:packaged": "node build/test-packaged.cjs",
    "build:server-manager": "dotnet publish server-manager/ShatootConnect.Server.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -o server-manager/publish",
    "test:workspace": "electron . --smoke-test --workspace-smoke",
    "test:media-ui": "electron . --smoke-test --media-smoke",
    "test:media-performance": "electron . --smoke-test --media-smoke --media-performance",
    "test:ice-ui": "electron . --smoke-test --ice-smoke",
    "test:connection-ui": "electron . --smoke-test --connection-ui-smoke",
    "test:keyboard-shift": "electron tests/keyboard-shift-probe.cjs",
    "test:native-text": "node tests/native-text-pipe.cjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.shatootsoft.connect",
    "productName": "Shatoot Connect",
    "asar": true,
    "files": [
      "desktop/**/*",
      "shared/**/*",
      "server/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/publish",
        "to": "input",
        "filter": [
          "ShatootConnect.Input.exe"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "app-icon.ico"
      },
      {
        "from": "build/chat-icon.ico",
        "to": "chat-icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "ShatootConnect-${version}-win-x64.exe"
    },
    "nsis": {
      "artifactName": "ShatootConnect-Setup-${version}-win-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033",
      "displayLanguageSelector": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shatoot Connect",
      "uninstallDisplayName": "Shatoot Connect",
      "include": "build/installer.nsh",
      "installerSidebar": "build/installerSidebar.bmp",
      "differentialPackage": false,
      "useZip": false
    },
    "directories": {
      "output": "release"
    }
  }
}
